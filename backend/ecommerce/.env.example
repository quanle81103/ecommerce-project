# Local Docker Compose values. Never put real production secrets in this file.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_S3_BUCKET=replace-me

JWT_SECRETKEY=replace-with-a-long-random-secret

GHN_TOKEN=replace-me
GHN_BASE_URL=https://online-gateway.ghn.vn

PAYMENT_VNPAY_TMNCODE=replace-me
PAYMENT_VNPAY_VERSION=2.1.0
PAYMENT_VNPAY_PAYURL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
PAYMENT_VNPAY_RETURNURL=http://localhost:8080/api/v1/payment/vnpay-callback
PAYMENT_VNPAY_COMMAND=pay
PAYMENT_VNPAY_ORDERTYPE=other
PAYMENT_VNPAY_HASHSECRET=replace-me

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=replace-me
SPRING_MAIL_PASSWORD=replace-me

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
